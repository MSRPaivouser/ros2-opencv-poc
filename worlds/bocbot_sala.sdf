<?xml version="1.0" ?>
<!-- Mundo e robo adaptados do repositorio basic_bocbot (ROS 2 Eloquent + Gazebo Classic)
     para ROS 2 Jazzy + Gazebo Harmonic (gz sim). Gerado por gen_world_lidar.py -->
<sdf version="1.8">
  <world name="bocbot_sala">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <light type="directional" name="sol">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="chao">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Escritorio (paredes do basic_bocbot) -->
    <model name="escritorio">
      <static>true</static>
      <pose>0.673102 -0.134423 0 0 0 0</pose>
      <link name="Wall_0">
        <pose>-7.92943 1.85 0 0 0 -1.5708</pose>
        <collision name="c0">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><box><size>4.0 0.15 2.5</size></box></geometry>
        </collision>
        <visual name="v0">
          <pose>0 0 1.25 0 0 0</pose>
          <geometry><box><size>4.0 0.15 2.5</size></box></geometry>
          <material><ambient>0.88 0.88 0.88 1</ambient><diffuse>0.88 0.88 0.88 1</diffuse></material>
        </visual>
      </link>
      <link name="Wall_3">
